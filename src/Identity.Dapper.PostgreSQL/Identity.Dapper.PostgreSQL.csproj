<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Identity package that uses Dapper with PostgreSQL instead EntityFramework for use with .NET Core.</Description>
    <AssemblyTitle>Identity.Dapper.PostgreSql</AssemblyTitle>
    <Authors>grandchamp</Authors>
    <!-- net8.0: ApparadApi'nin tükettiği hat — Npgsql sürümü Api ile birebir aynı
         olsun diye eklendi (GHSA-x9vc-6hfv-hg8c / NU1903).
         netstandard2.0: bu repodaki eski test/sample projeleri (netcoreapp2.0)
         referans verdiği için korunuyor. -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>Identity.Dapper.PostgreSQL</AssemblyName>
    <PackageId>Identity.Dapper.PostgreSQL</PackageId>
    <PackageTags>asp.net;core;dapper;identity;psql;postgresql</PackageTags>
    <PackageProjectUrl>https://github.com/grandchamp/Identity.Dapper</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/grandchamp/Identity.Dapper.git</RepositoryUrl>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <Version>0.8.4-alpha</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AssemblyVersion>0.8.4.0</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Identity.Dapper\Identity.Dapper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="2.2.0" />
  </ItemGroup>

  <!-- Npgsql 9.x netstandard2.0 taşımıyor (yalnız net6.0/net8.0), o yüzden TFM başına ayrı.
       Kullanılan yüzey NpgsqlConnection + NpgsqlConnectionStringBuilder ile sınırlı;
       iki hat arasında API farkı yok. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Npgsql" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Npgsql" Version="4.0.17" />
  </ItemGroup>

</Project>
